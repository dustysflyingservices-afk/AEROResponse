generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OPS)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

enum AircraftCategory {
  SINGLE_ENGINE_PISTON
  MULTI_ENGINE_PISTON
  TURBOPROP
  JET
  HELICOPTER
  OTHER
}

model Organization {
  id           String    @id @default(cuid())
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  missions     Mission[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Pilot fields mirror the real intake source (Volunteer Pilot Interest Form):
// name, contact info, address, PIC time, airmen ratings, motivation. Aircraft
// remains a separate related table - a pilot can have 0, 1, or several - but
// the app's UI now creates/edits a pilot and their aircraft together in one
// combined form instead of two separate entry flows.
// ---------------------------------------------------------------------------

model Pilot {
  id    String @id @default(cuid())
  firstName String
  lastName  String
  email     String? @unique
  phone     String?

  street1 String?
  street2 String?
  city    String?
  state   String?
  zipCode String?

  picTotalTime  String?
  airmenRatings String?
  motivation    String?
  notes         String?

  aircraft  Aircraft[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("pilots")
}

model Aircraft {
  id              String           @id @default(cuid())
  nNumber         String?          @unique
  makeModel       String
  homeBaseAirport String?
  category        AircraftCategory @default(OTHER)
  usefulLoadLbs   Int?
  rangeNm         Int?
  minRunwayFt     Int?
  pilotId         String
  pilot           Pilot            @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([pilotId])
  @@map("aircraft")
}

enum MissionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MissionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Mission {
  id String @id @default(cuid())

  // WHO
  pointOfContact     String?
  missionCoordinator String?
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])

  // WHAT
  missionDescription  String
  cargoPassengers     String?
  aircraftNeededNotes String?
  specialRequirements String?

  // Structured filters for the matching engine
  requiredCategory AircraftCategory?
  minUsefulLoadLbs Int?
  minRangeNm       Int?
  minRunwayFt      Int?

  // WHEN
  launchWindow      String?
  responseNeededBy  DateTime?
  estimatedDuration String?

  // WHERE
  stagingAirport      String
  destinationAirports String[]

  // WHY
  situationSummary String?
  priority         MissionPriority @default(MEDIUM)

  status    MissionStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([organizationId])
  @@map("missions")
}
