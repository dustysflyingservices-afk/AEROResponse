generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Milestone 1: authentication only. Organization / Pilot / Aircraft / Mission
// models are introduced in Milestones 2-3 to keep the schema scoped to what
// the app actually uses at each stage.
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  OPS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OPS)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ---------------------------------------------------------------------------
// Milestone 2: Organizations (requesting agencies), Pilots, and Aircraft.
// Aircraft carries the structured fields the Milestone 4 matching engine
// will filter on (category, useful load, range, runway requirement) so the
// schema doesn't need to change again when matching is built.
// ---------------------------------------------------------------------------

enum AircraftCategory {
  SINGLE_ENGINE_PISTON
  MULTI_ENGINE_PISTON
  TURBOPROP
  JET
  HELICOPTER
  OTHER
}

model Organization {
  id           String    @id @default(cuid())
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  missions     Mission[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("organizations")
}

model Pilot {
  id             String     @id @default(cuid())
  name           String
  email          String?    @unique
  phone          String?
  notes          String?
  qualifications String?
  aircraft       Aircraft[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("pilots")
}

model Aircraft {
  id              String           @id @default(cuid())
  nNumber         String           @unique
  makeModel       String
  homeBaseAirport String?
  category        AircraftCategory @default(OTHER)
  usefulLoadLbs   Int?
  rangeNm         Int?
  minRunwayFt     Int?
  pilotId         String
  pilot           Pilot            @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([pilotId])
  @@map("aircraft")
}

// ---------------------------------------------------------------------------
// Milestone 3: Mission database, search, creation, and editing. Modeled
// directly on the "Volunteer Pilot Activation" intake form (Who/What/When/
// Where/Why). The structured fields under WHAT (category, minUsefulLoadLbs,
// minRangeNm, minRunwayFt) are what Milestone 4's matching engine filters
// Aircraft against - they sit alongside the free-text notes ops actually
// receives, rather than replacing them.
// ---------------------------------------------------------------------------

enum MissionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MissionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Mission {
  id String @id @default(cuid())

  // WHO
  pointOfContact     String?
  missionCoordinator String?
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])

  // WHAT
  missionDescription  String
  cargoPassengers     String?
  aircraftNeededNotes String?
  specialRequirements String?

  // Structured filters for the Milestone 4 matching engine
  requiredCategory      AircraftCategory?
  minUsefulLoadLbs      Int?
  minRangeNm            Int?
  minRunwayFt           Int?

  // WHEN
  launchWindow      String?
  responseNeededBy  DateTime?
  estimatedDuration String?

  // WHERE
  stagingAirport      String
  destinationAirports String[]

  // WHY
  situationSummary String?
  priority         MissionPriority @default(MEDIUM)

  status    MissionStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([organizationId])
  @@map("missions")
}
