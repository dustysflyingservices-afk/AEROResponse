generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Milestone 1: authentication only. Organization / Pilot / Aircraft / Mission
// models are introduced in Milestones 2-3 to keep the schema scoped to what
// the app actually uses at each stage.
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  OPS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OPS)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ---------------------------------------------------------------------------
// Milestone 2: Organizations (requesting agencies), Pilots, and Aircraft.
// Aircraft carries the structured fields the Milestone 4 matching engine
// will filter on (category, useful load, range, runway requirement) so the
// schema doesn't need to change again when matching is built.
// ---------------------------------------------------------------------------

enum AircraftCategory {
  SINGLE_ENGINE_PISTON
  MULTI_ENGINE_PISTON
  TURBOPROP
  JET
  HELICOPTER
  OTHER
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("organizations")
}

model Pilot {
  id        String     @id @default(cuid())
  name      String
  email     String?    @unique
  phone     String?
  notes     String?
  aircraft  Aircraft[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("pilots")
}

model Aircraft {
  id              String           @id @default(cuid())
  nNumber         String           @unique
  makeModel       String
  homeBaseAirport String?
  category        AircraftCategory @default(OTHER)
  usefulLoadLbs   Int?
  rangeNm         Int?
  minRunwayFt     Int?
  pilotId         String
  pilot           Pilot            @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([pilotId])
  @@map("aircraft")
}
